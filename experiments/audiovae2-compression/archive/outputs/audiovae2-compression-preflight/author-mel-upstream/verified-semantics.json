{
  "name": "author-referenced DAC seven-scale mel at 48 kHz",
  "authority": "Original AudioVAE collaborator reply https://github.com/OpenBMB/VoxCPM/issues/145#issuecomment-3767009845 references DAC. Exact historical dependency versions and complete AudioVAE2 recipe remain unverified.",
  "sample_rate": 48000,
  "window_lengths": [
    32,
    64,
    128,
    256,
    512,
    1024,
    2048
  ],
  "n_mels": [
    5,
    10,
    20,
    40,
    80,
    160,
    320
  ],
  "hop_lengths": [
    8,
    16,
    32,
    64,
    128,
    256,
    512
  ],
  "window": {
    "name": "hann",
    "periodic": true,
    "upstream_construction": "scipy.signal.get_window(window_type, window_length); convert to torch.float32",
    "docstring_warning": "audiotools docstrings say sqrt_hann; actual default setter is hann"
  },
  "stft": {
    "n_fft": "window_length",
    "win_length": "window_length",
    "center": true,
    "pad_mode": "reflect",
    "normalized": false,
    "onesided": true,
    "return_complex": true,
    "match_stride": false,
    "explicit_padding_before_stft": 0,
    "dropped_output_frames": 0,
    "frames_for_length_L": "L // hop_length + 1"
  },
  "mel": {
    "magnitude": "abs(complex STFT), not squared magnitude",
    "htk": false,
    "norm": "slaney",
    "dtype": "float32",
    "fmin": 0.0,
    "fmax": 24000.0,
    "upstream_fmax_argument": null,
    "normalization": "triangular bands multiplied by 2/(right_edge_hz-left_edge_hz)"
  },
  "loss": {
    "pow": 1.0,
    "clamp_eps": 1e-05,
    "log_base": 10,
    "log_weight": 1.0,
    "mag_weight": 0.0,
    "within_scale": "mean absolute difference over all batch, channel, mel, and frame elements",
    "across_scales": "sum, no division by 7",
    "operation_order": "mel magnitude, clamp minimum, power, log10, L1",
    "prohibited_extra_processing": [
      "amplitude normalization",
      "STFT energy normalization",
      "dB conversion factor10or20",
      "maximum-level subtraction",
      "mel per-frame normalization"
    ]
  },
  "pilot_adaptations": [
    "48 kHz sample rate rather than claiming exact historical original pretraining rate",
    "variable-length sources pooled by actual per-resolution mel element counts; no padded-tail scoring",
    "teacher waveform and complete-stage4 boundary losses retained",
    "outer coefficient remains pilot policy, not automatically official mel15",
    "no standalone STFT loss, GAN, KL or V2 low-band term included by this seven-scale loss definition"
  ],
