resolved black/ruff versions in the job log so any\n+        # future drift is easy to spot at a glance.\n+        run: |\n+          python -m black --version\n+          python -m ruff --version\n+\n       - name: Check formatting with Black\n-        run: black --check supertonic tests\n+        # `python -m black` (not bare `black`) so we definitely use the one\n+        # pip just installed into this venv. `--diff` makes the job log\n+        # show exactly which lines need reformatting if it ever fails.\n+        run: python -m black --check --diff supertonic tests\n \n       - name: Lint with Ruff\n-        run: ruff check supertonic tests\n+        run: python -m ruff check supertonic tests"},{"sha":"5702dfa4eee34b08c758327a2785f160940dacc5","filename":"tests/test_server_routes.py","status":"modified","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/supertone-inc/supertonic-py/blob/908a56486e821e833a80530ff0cae3ad0b046fce/tests%2Ftest_server_routes.py","raw_url":"https://github.com/supertone-inc/supertonic-py/raw/908a56486e821e833a80530ff0cae3ad0b046fce/tests%2Ftest_server_routes.py","contents_url":"https://api.github.com/repos/supertone-inc/supertonic-py/contents/tests%2Ftest_server_routes.py?ref=908a56486e821e833a80530ff0cae3ad0b046fce","patch":"@@ -23,7 +23,6 @@\n \n from supertonic.server import ServerState, create_app  # noqa: E402\n \n-\n SAMPLE_RATE = 44100\n \n "}]}